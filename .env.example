# Copy this file to .env and fill it in. .env is git-ignored. Never commit a real key.
# These are read only by server/ (Node). They have no VITE_ prefix on purpose,
# so Vite never puts them in the browser bundle.

# Required for AI triage. Without it the app uses the keyword fallback.
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# PORT=8787
