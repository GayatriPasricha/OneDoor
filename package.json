{
  "name": "onedoor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "smoke": "node --env-file-if-exists=.env server/smoke.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/server.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "vite": "^5.4.11"
  }
}
